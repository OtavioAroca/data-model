{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Índice do Catálogo — Contrato",
  "description": "Define a estrutura esperada de catalog/index.yaml",
  "type": "object",
  "required": ["meta", "subdominios"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["titulo", "o_que_e", "o_que_nao_e", "convencao_camadas"],
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "o_que_e": {
          "type": "string",
          "minLength": 1
        },
        "como_ler": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "o_que_nao_e": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "convencao_camadas": {
          "type": "object",
          "required": ["Core", "Integration", "Analytics"],
          "properties": {
            "Core": {
              "type": "string",
              "minLength": 1
            },
            "Integration": {
              "type": "string",
              "minLength": 1
            },
            "Analytics": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "subdominios": {
      "type": "array",
      "minItems": 1,
      "description": "Lista de todos os subdomínios do domínio",
      "items": {
        "type": "object",
        "required": ["nome", "slug", "bounded_context", "sistemas_origem", "tipo_ddd", "tem_mapeamento_tecnico"],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "description": "Nome do subdomínio (ex: Elegibilidade)"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
            "description": "Slug em kebab-case sem acentos (ex: compras-autorizacao)"
          },
          "bounded_context": {
            "type": "string",
            "minLength": 1
          },
          "sistemas_origem": {
            "type": "string",
            "minLength": 1
          },
          "tipo_ddd": {
            "type": "string",
            "enum": ["Core", "Support", "Generic"]
          },
          "tem_mapeamento_tecnico": {
            "type": "boolean",
            "description": "Se existe catalog/<slug>/mapeamento-tecnico.yaml"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
